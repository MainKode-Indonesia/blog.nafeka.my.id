---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getDirectusArticles } from "../../lib/directus";
import type { DirectusArticle } from "../../lib/directus";
import { adaptDirectusArticle } from "../../lib/article-adapter";
import sanitizeHtml from "sanitize-html";

type ArticleProps =
  | {
      source: "markdown";
      article: CollectionEntry<"articles">;
    }
  | {
      source: "directus";
      article: DirectusArticle;
    };

export async function getStaticPaths() {
  const markdownArticles = await getCollection(
    "articles",
    ({ data }) => !data.draft
  );

  const directusArticles = await getDirectusArticles();

  // Markdown mendapat prioritas apabila slug sama.
  const markdownSlugs = new Set(
    markdownArticles.map((article) => article.id)
  );

  const markdownPaths = markdownArticles.map((article) => ({
    params: { slug: article.id },
    props: {
      source: "markdown" as const,
      article,
    },
  }));

  const directusPaths = directusArticles
    .filter((article) => !markdownSlugs.has(article.slug))
    .map((article) => ({
      params: { slug: article.slug },
      props: {
        source: "directus" as const,
        article,
      },
    }));

  return [...markdownPaths, ...directusPaths];
}

const props = Astro.props as ArticleProps;
const isMarkdown = props.source === "markdown";

const markdownArticle = isMarkdown ? props.article : null;
const directusArticle = !isMarkdown ? props.article : null;

const unified = directusArticle
  ? adaptDirectusArticle(directusArticle)
  : null;

const id = markdownArticle?.id ?? unified?.id ?? "";

const title = markdownArticle?.data.title ?? unified?.title ?? "";
const description =
  markdownArticle?.data.description ?? unified?.description ?? "";

const category =
  markdownArticle?.data.category ?? unified?.category ?? "Umum";

const pubDate =
  markdownArticle?.data.pubDate ?? unified?.pubDate ?? new Date(0);

const updatedDate =
  markdownArticle?.data.updatedDate ?? pubDate;

const readingTime =
  markdownArticle?.data.readingTime ?? unified?.readingTime ?? 1;

const tags = markdownArticle?.data.tags ?? [];

// Markdown tetap menggunakan renderer Astro.
const rendered = markdownArticle
  ? await render(markdownArticle)
  : null;

const Content = rendered?.Content;

// HTML dari Directus dibersihkan sebelum dirender.
const directusHtml = directusArticle
  ? sanitizeHtml(directusArticle.content ?? "", {
      allowedTags: [
        ...sanitizeHtml.defaults.allowedTags,
        "img",
        "h1",
        "h2",
      ],
      allowedAttributes: {
        ...sanitizeHtml.defaults.allowedAttributes,
        img: ["src", "alt", "title", "width", "height"],
      },
      allowedSchemes: ["http", "https", "mailto"],
    })
  : "";

const date = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(pubDate);

const articleUrl = new URL(
  `/artikel/${id}/`,
  Astro.site ?? Astro.url
).href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate.toISOString(),
  mainEntityOfPage: articleUrl,
  author: {
    "@type": "Organization",
    name: "KataKode",
  },
  publisher: {
    "@type": "Organization",
    name: "KataKode",
    url: "https://blog.nafeka.my.id",
  },
};
---

<BaseLayout
  title={`${title} — KataKode`}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate.toISOString()}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema).replace(/</g, "\\u003c")}
  />

  <main class="container-site py-16 md:py-24">
    <article class="mx-auto max-w-3xl">
      <a
        href="/artikel/"
        class="text-sm font-medium text-muted hover:text-primary"
      >
        ← Kembali ke Artikel
      </a>

      <header class="mt-12 border-b border-border pb-10">
        <span class="eyebrow">{category}</span>

        <h1
          class="mt-5 text-4xl font-bold leading-tight tracking-tight md:text-6xl"
        >
          {title}
        </h1>

        <p class="mt-6 text-lg leading-8 text-muted">
          {description}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3 text-sm text-muted">
          <time datetime={pubDate.toISOString().slice(0, 10)}>
            {date}
          </time>

          <span>•</span>
          <span>{readingTime} menit baca</span>
        </div>
      </header>

      <div class="article-content mt-12">
        {
          isMarkdown && Content
            ? <Content />
            : <Fragment set:html={directusHtml} />
        }
      </div>

      <footer class="mt-16 border-t border-border pt-8">
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">
                  #{tag}
                </span>
              ))}
            </div>
          )
        }

        <a
          href="/artikel/"
          class="mt-10 inline-block text-sm font-semibold text-primary hover:underline"
        >
          ← Lihat artikel lainnya
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>

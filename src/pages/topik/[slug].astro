---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ui/ArticleCard.astro";

import { topics } from "../../data/topics";
import type { Topic } from "../../data/topics";
import { getPublishedArticles } from "../../lib/articles";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const articles = await getPublishedArticles();

    return topics.map((topic) => ({
        params: {
            slug: topic.slug,
        },
        props: {
            topic,
            articles: articles.filter(
                (article) => article.data.category === topic.name,
            ),
        },
    }));
}

interface Props {
    topic: Topic;
    articles: CollectionEntry<"articles">[];
}

const { topic, articles } = Astro.props;
---

<BaseLayout title={`${topic.name} — KataKode`} description={topic.description}>
    <main class="container-site section-spacing">
        <a
            href="/topik/"
            class="text-sm font-medium text-muted hover:text-primary"
        >
            ← Semua Topik
        </a>

        <header class="mb-14 mt-12 max-w-3xl">
            <div
                class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-2xl font-bold text-primary"
            >
                {topic.icon}
            </div>

            <span class="eyebrow">KataKode Topics</span>

            <h1 class="mt-5 text-5xl font-bold tracking-tight md:text-6xl">
                {topic.name}<span class="text-primary">.</span>
            </h1>

            <p class="mt-6 text-lg leading-8 text-muted">
                {topic.description}
            </p>

            <p class="mt-5 text-sm text-muted">
                {articles.length} artikel tersedia
            </p>
        </header>

        {
            articles.length > 0 ? (
                <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {articles.map((article) => (
                        <ArticleCard article={article} />
                    ))}
                </div>
            ) : (
                <div class="rounded-2xl border border-border bg-surface p-10 text-center">
                    <h2 class="text-xl font-semibold">Belum ada artikel</h2>

                    <p class="mt-3 text-sm leading-7 text-muted">
                        Artikel untuk kategori {topic.name}
                        sedang dipersiapkan.
                    </p>

                    <a
                        href="/artikel/"
                        class="mt-6 inline-block text-sm font-semibold text-primary hover:underline"
                    >
                        Jelajahi artikel lainnya →
                    </a>
                </div>
            )
        }
    </main>
</BaseLayout>
